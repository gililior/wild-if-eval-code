# Copy to `.env` and fill in. The scripts read these via os.environ.get(NAME).

# API key for the inference / judge endpoint.
# Default for --API_key_name is OPENAI_API_KEY, but any name works as long as
# you pass --API_key_name MY_VAR_NAME to the scripts.
OPENAI_API_KEY=

# Required only when pushing artifacts back to the HuggingFace Hub
# (e.g. arena_filtering/upload_data_to_hf.py).
HF_TOKEN=
